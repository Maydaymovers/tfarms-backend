# Copy this file to .env and fill in your PostgreSQL connection string.
# Format: ******HOST:PORT/DATABASE_NAME?schema=public
DATABASE_URL=

# Comma-separated list of valid API keys for X-API-Key (required for ALL /payouts and /ledger routes, including reads; missing or invalid key returns 401).
API_KEYS=
# Frontend origin allowed by CORS.
FRONTEND_ORIGIN=http://localhost:3000
