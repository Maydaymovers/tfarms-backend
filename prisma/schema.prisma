generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rail {
  ACH    @map("ach")
  PAYPAL @map("paypal")
  RTP    @map("rtp")
  WALLET @map("wallet")
  MANUAL @map("manual")
  OTHER  @map("other")
}

enum PayoutStatus {
  PENDING         @map("pending")
  PROCESSING      @map("processing")
  COMPLETED       @map("completed")
  FAILED          @map("failed")
  REVERSED        @map("reversed")
  REQUIRES_REVIEW @map("requires_review")
}

enum LedgerEntryType {
  PAYOUT_DEBIT      @map("payout_debit")
  PAYOUT_FEE        @map("payout_fee")
  PAYOUT_REVERSAL   @map("payout_reversal")
  ADJUSTMENT_CREDIT @map("adjustment_credit")
  ADJUSTMENT_DEBIT  @map("adjustment_debit")
}

enum HotelRole {
  OWNER
  MANAGER
  STAFF
}

model Hotel {
  id        String        @id @default(uuid())
  name      String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  members   HotelMember[]
  vendors   Vendor[]
  payouts   Payout[]
  ledger    LedgerEntry[]
}

// One Wix member belongs to exactly one hotel (wixMemberId is unique).
model HotelMember {
  id          String      @id @default(uuid())
  hotelId     String
  wixMemberId String      @unique
  role        HotelRole   @default(STAFF)
  createdAt   DateTime    @default(now())
  hotel       Hotel       @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId])
}

enum VendorStatus {
  PENDING
  SETUP_REQUIRED
  BANK_CONNECTED
  VERIFICATION_PENDING
  ACTIVE
  SUSPENDED
}

model Vendor {
  id           String   @id @default(uuid())
  hotelId      String?
  hotel        Hotel?   @relation(fields: [hotelId], references: [id])
  name         String
  contactEmail String?
  status       VendorStatus @default(PENDING)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  onboarding   VendorOnboarding?
  statusEvents VendorStatusEvent[]

  @@index([hotelId])
  @@index([status])
}

model VendorStatusEvent {
  id        String         @id @default(uuid())
  vendorId  String
  hotelId   String?
  oldStatus VendorStatus
  newStatus VendorStatus
  // 'platform_admin' for API-key-only calls, otherwise 'member:<HotelMember.id>'
  changedBy String
  reason    String?
  createdAt DateTime       @default(now())
  vendor    Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, createdAt])
}

model IdempotencyKey {
  id          String   @id @default(uuid())
  // hotelId for member requests, 'service' otherwise
  scope       String
  key         String
  requestHash String
  response    Json
  createdAt   DateTime @default(now())

  @@unique([scope, key])
}

enum VendorOnboardingStatus {
  STARTED
}

model VendorOnboarding {
  id        String                 @id @default(uuid())
  vendorId  String                 @unique
  status    VendorOnboardingStatus @default(STARTED)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  vendor    Vendor                 @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model Payout {
  id                    String        @id @default(uuid())
  hotelId               String?
  hotel                 Hotel?        @relation(fields: [hotelId], references: [id])
  vendorId              String
  amount                Decimal       @db.Decimal(18, 2)
  currency              String        @default("USD") @db.Char(3)
  rail                  Rail
  status                PayoutStatus  @default(PENDING)
  externalTransactionId String?
  failureReason        String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  ledgerEntries         LedgerEntry[]
  statusEvents          PayoutStatusEvent[]

  @@index([hotelId])
  @@index([vendorId])
  @@index([status])
  @@index([rail])
}

model PayoutStatusEvent {
  id        String       @id @default(uuid())
  payoutId  String
  hotelId   String?
  oldStatus PayoutStatus
  newStatus PayoutStatus
  // 'platform_admin' for API-key-only calls, otherwise 'member:<HotelMember.id>'
  changedBy String
  reason    String?
  createdAt DateTime     @default(now())
  payout    Payout       @relation(fields: [payoutId], references: [id], onDelete: Cascade)

  @@index([payoutId, createdAt])
}

model LedgerEntry {
  id        String          @id @default(uuid())
  hotelId   String?
  hotel     Hotel?          @relation(fields: [hotelId], references: [id])
  type      LedgerEntryType
  amount    Decimal         @db.Decimal(18, 2)
  currency  String          @default("USD") @db.Char(3)
  vendorId  String?
  payoutId  String?
  createdAt DateTime        @default(now())
  payout    Payout?         @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([hotelId])
  @@index([vendorId])
  @@index([type])
  @@index([payoutId])
}
